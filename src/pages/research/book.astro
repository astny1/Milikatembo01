---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const items = (await getCollection('book')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Book Project"
  description="A book project in development alongside Milika Tembo’s doctoral research on bibliotherapy."
>
  <header class="page-hero research-hero">
    <div class="wrap">
      <h1>Book Project</h1>
      {items.length === 0 && <p class="page-sub">Coming soon.</p>}
    </div>
  </header>

  {items.length > 0 && (
    <section class="section">
      <div class="wrap book-grid">
        {items.map((item) => (
          <article class="book-card">
            {item.data.image && (
              <div class="book-card-media">
                <img src={item.data.image} alt="" width="480" height="640" />
              </div>
            )}
            <div class="book-card-body">
              {item.data.meta && <p class="category">{item.data.meta}</p>}
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
            </div>
            {item.data.link && (
              <div class="book-card-foot">
                <a class="btn btn-gold" href={item.data.link} rel="noopener">
                  {item.data.linkLabel || 'Read more'}
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
