---
import site from '../data/site.json';

const sent = Astro.url.pathname.replace(/\/+$/, '') === '/sent';
const action = '/sent/';

const linkedin = 'https://www.linkedin.com/in/milika-tembo-0b277b122';

const social = [
  {
    label: 'LinkedIn',
    href: linkedin,
    icon: 'linkedin' as const,
  },
  {
    label: 'YouTube',
    href: site.youtube,
    icon: 'youtube' as const,
  },
  ...(site.instagram
    ? [
        {
          label: 'Instagram',
          href: site.instagram,
          icon: 'instagram' as const,
        },
      ]
    : []),
  ...(site.twitter
    ? [
        {
          label: 'X',
          href: site.twitter,
          icon: 'twitter' as const,
        },
      ]
    : []),
  ...(site.facebook
    ? [
        {
          label: 'Facebook',
          href: site.facebook,
          icon: 'facebook' as const,
        },
      ]
    : []),
];
---

<footer class="site-footer" id="site-footer">
  <div class="home-wide footer-relax">
    <div class="footer-copy">
      <h2>{site.name}</h2>
      <p class="footer-creds">{site.credentials}</p>
      <p>A short note is enough lectures, workshops, research or a conversation about bibliotherapy.</p>
      <p class="footer-meta">
        <a href="/privacy/">Privacy policy</a>
        · {site.location}
      </p>
      <div class="footer-icons" aria-label="Social media">
        {social.map((item) => (
          item.href ? (
            <a
              class="footer-icon"
              href={item.href}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={item.label}
            >
              {item.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.25h4.52V24H.24V8.25zM8.24 8.25h4.33v2.14h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.43 3.01 5.43 6.93V24h-4.52v-7.84c0-1.87-.03-4.28-2.61-4.28-2.61 0-3.01 2.04-3.01 4.14V24H8.24V8.25z" />
                </svg>
              )}
              {item.icon === 'youtube' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z" />
                </svg>
              )}
              {item.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
                </svg>
              )}
              {item.icon === 'twitter' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.995-9.232L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {item.icon === 'facebook' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22.68 0H1.32C.59 0 0 .59 0 1.32v21.36C0 23.41.59 24 1.32 24h11.5v-9.29H9.69V11.1h3.13V8.41c0-3.1 1.89-4.79 4.66-4.79 1.32 0 2.46.1 2.79.14v3.24h-1.92c-1.5 0-1.79.72-1.79 1.76v2.31h3.58l-.47 3.61h-3.11V24h6.12c.73 0 1.32-.59 1.32-1.32V1.32C24 .59 23.41 0 22.68 0z" />
                </svg>
              )}
            </a>
          ) : (
            <span class="footer-icon" aria-label={`${item.label} will appear here once the link is added`}>
              {item.icon === 'facebook' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22.68 0H1.32C.59 0 0 .59 0 1.32v21.36C0 23.41.59 24 1.32 24h11.5v-9.29H9.69V11.1h3.13V8.41c0-3.1 1.89-4.79 4.66-4.79 1.32 0 2.46.1 2.79.14v3.24h-1.92c-1.5 0-1.79.72-1.79 1.76v2.31h3.58l-.47 3.61h-3.11V24h6.12c.73 0 1.32-.59 1.32-1.32V1.32C24 .59 23.41 0 22.68 0z" />
                </svg>
              )}
            </span>
          )
        ))}
      </div>
    </div>

    <div class="footer-form-wrap">
      {sent && (
        <p class="footer-sent" role="status">Thank you for your submission. We will respond to you within 24 hours.</p>
      )}
      <form
        class="footer-form"
        name="footer-enquiry"
        method="POST"
        action={action}
        data-netlify="true"
        netlify-honeypot="bot-field"
        hidden={sent}
      >
        <input type="hidden" name="form-name" value="footer-enquiry" />
        <input type="hidden" name="subject" value="New footer note — Milika Tembo" />
        <input type="hidden" name="enquiry-type" value="Footer note" />
        <p class="honeypot">
          <label>
            Do not fill this field
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        <div class="footer-form-row">
          <label>
            Name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          Message
          <textarea name="message" rows="3" required placeholder="A few lines are enough."></textarea>
        </label>
        <button class="btn btn-gold" type="submit">Send note</button>
      </form>
    </div>
  </div>

  <div class="home-wide footer-bottom">
    <span>Copyright © {new Date().getFullYear()} <strong>Milika Tembo</strong>. All rights reserved.</span>
    <span class="footer-credit">
      Designed by <a href="https://www.growhivemedea.com"><strong>Growhive Media</strong></a>
    </span>
  </div>
</footer>
